# ============ DO DIGITALS — environment template ============
# Copy to .env (local) or paste values into Vercel → Settings → Environment Variables

# ---- Database ----
# Local development (SQLite). Path is relative to prisma/schema.prisma.
DATABASE_URL=file:../db/custom.db

# PRODUCTION (Vercel): SQLite is NOT supported on Vercel serverless.
# Use a hosted database and switch prisma/schema.prisma provider accordingly:
#   Vercel Postgres / Neon / Supabase  →  provider = "postgresql"
#   Turso (libSQL)                     →  see README-DEPLOY.md option B
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ---- Auth (REQUIRED in production) ----
# JWT signing secret for admin sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=

# ---- Optional ----
# Password for the auto-created admin on a FRESH database (default: DoDigitals@2025)
# ADMIN_PASSWORD=ChangeMe@2025

# Origin allowlist for admin CSRF checks (only needed behind exotic proxies)
# ADMIN_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# APP_URL=https://yourdomain.com
