# TIMES UP COLLECTIONS — Environment Variables
#
# Copy this file to .env and fill in your real values.
# NEVER commit your real .env file to git.

# ============================================================================
# DATABASE_URL
# ============================================================================
#
# For LOCAL DEVELOPMENT (SQLite):
DATABASE_URL=file:./db/custom.db

# For PRODUCTION (Neon PostgreSQL on Vercel):
# Get this from https://neon.com → your project → Connection Details → pooled:
# DATABASE_URL=postgresql://username:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ============================================================================
# ADMIN_SESSION_SECRET
# ============================================================================
# Generate a strong random secret:
#   openssl rand -hex 32
# Or use any 64+ character random hex string.
ADMIN_SESSION_SECRET=change-me-to-a-random-64-character-hex-string

# ============================================================================
# Optional: Upload directory (leave unset for database-backed storage)
# ============================================================================
# UPLOADS_DIR=
